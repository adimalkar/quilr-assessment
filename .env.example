# Copy to .env (docker compose reads it automatically) or export in your shell.

# ---- Task 2: MCP security gateway
GATEWAY_JWT_SECRET=change-me-to-32+-random-bytes-eg-openssl-rand-hex-32
GATEWAY_DOWNSTREAM_URL=http://127.0.0.1:9101/mcp
# GATEWAY_JWT_ISSUER=
# GATEWAY_JWT_AUDIENCE=
# GATEWAY_DOWNSTREAM_TOKEN=          # credential the gateway presents downstream (client tokens are never forwarded)
# GATEWAY_ALLOWED_ORIGINS=           # comma-separated browser Origins; requests without Origin are unaffected
# GATEWAY_FILTER_TOOLS_LIST=0        # 1 = hide admin_* tools from non-admins in tools/list
# GATEWAY_REDACT_TOOL_RESULTS=off    # off | viewers | all  (PII redaction of tool results)
# GATEWAY_PIN_TOOLS=0                # 1 = quarantine tools whose definition changes after first sight

# ---- Task 3: streaming PII guardrail
GUARD_UPSTREAM_BASE_URL=http://127.0.0.1:8301/v1   # e.g. https://api.openai.com/v1
# GUARD_UPSTREAM_API_KEY=
# GUARD_HEARTBEAT_S=15

# ---- Task 4: rate limiter + model router
ROUTER_DB_PATH=./data/router.db
ROUTER_TENANTS=tenant-key-1:acme,tenant-key-2:globex:100000   # key:name[:tokens_per_minute]
ROUTER_TPM=50000
ROUTER_PRIMARY_URL=http://127.0.0.1:8401/v1
ROUTER_SECONDARY_URL=http://127.0.0.1:8402/v1
# ROUTER_PRIMARY_API_KEY= / ROUTER_SECONDARY_API_KEY=
# ROUTER_PRIMARY_MODEL= / ROUTER_SECONDARY_MODEL=
# ROUTER_PRIMARY_TIMEOUT_MS=3000
# ROUTER_SECONDARY_TIMEOUT_MS=10000
# ROUTER_REDACT_PII=0                # 1 = run Task 3's guardrail on every routed response
# ROUTER_HEARTBEAT_S=15

# ---- Task 1: MCP server
# MCP_LOG_LEVEL=INFO
# MCP_VALIDATION_ERRORS=protocol     # protocol (-32602, as the brief asks) | tool (isError, SEP-1303)
